{% comment %}
  Person structured data with alternateName — the legitimate, invisible way to
  be found under name variants/spellings (Latin + Greek).
  Scoped to the homepage so there's a single canonical Person entity.
{% endcomment %}
{% if page.url == '/' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "George Kontogiannis",
      "alternateName": ["Georgios Kontogiannis", "Giorgos Kontogiannis", "Georgios Kontogiannhs", "Γιώργος Κοντογιάννης", "Γεώργιος Κοντογιάννης"],
      "url": "https://kontogiannisg.github.io/",
      "jobTitle": "Ph.D. Candidate in Artificial Intelligence",
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "University of Patras"
      },
      "sameAs": [
        "https://scholar.google.com/citations?user=4-FB1MoAAAAJ",
        "https://github.com/kontogiannisg",
        "https://www.linkedin.com/in/george-kontogiannis",
        "https://orcid.org/0009-0003-7982-0991",
        "https://www.researchgate.net/profile/George-Kontogiannis-2/"
      ]
    }
  </script>
{% endif %}

{% capture footer_contents %}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid %}
      {% endif %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
